{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphward.dev/schemas/convention-findings.schema.json",
  "title": "GraphWard completed convention-findings evidence",
  "description": "A completed candidate-bound supplied review. Source binding does not attest to semantic review quality; waivers require a future expiry at evaluation.",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "reviewer",
    "reviewedAt",
    "binding",
    "findings"
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectRoot",
        "runtimeGeneration",
        "files"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "projectRoot": {
          "type": "string",
          "minLength": 1
        },
        "runtimeGeneration": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{64}|missing)$"
          }
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "complete"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "message",
          "confidence",
          "adherence"
        ],
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "waiver": {
            "type": "object",
            "required": [
              "owner",
              "rationale",
              "expiresAt"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "adherence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
