{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphward.dev/schemas/convention-findings.schema.json",
  "type": "object",
  "required": ["schemaVersion", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "findings": { "type": "array", "items": { "type": "object", "required": ["id", "message", "severity", "category", "confidence", "adherence"], "properties": { "id": { "type": "string" }, "message": { "type": "string" }, "severity": { "enum": ["critical", "major", "minor"] }, "category": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "adherence": { "type": "number", "minimum": 0, "maximum": 1 }, "waiver": { "type": "object", "required": ["owner", "rationale"], "properties": { "owner": { "type": "string" }, "rationale": { "type": "string" }, "expiresAt": { "type": "string", "format": "date-time" } } } } } }
  }
}
