{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GraphWard Project Config",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 2 },
    "tokenBudgets": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
    "projectFiles": {
      "type": "object",
      "properties": {
        "roots": { "type": "array", "items": { "type": "string" } },
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "providers": {
      "type": "object",
      "properties": {
        "policy": { "type": "string", "enum": ["auto", "full", "native"] },
        "requireProviders": { "type": "boolean" },
        "exposeRawMcp": { "type": "boolean" },
        "offline": { "type": "boolean" }
      },
      "required": ["policy", "requireProviders", "exposeRawMcp", "offline"]
    },
    "hooks": {
      "type": "object",
      "properties": {
        "verifyCommands": { "type": "array", "items": { "type": "string" } },
        "freshnessThreshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "blockStaleEdits": { "type": "boolean" },
        "requireValidationOnStop": { "type": "boolean" }
      },
      "required": ["verifyCommands", "freshnessThreshold", "blockStaleEdits", "requireValidationOnStop"]
    }
  },
  "required": ["schemaVersion", "tokenBudgets", "projectFiles", "providers", "hooks"]
}
