{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GraphWard Verification Record",
  "description": "Executed checks bind source, root, check specification and runtime generation. Legacy records and custom checks that omit required checks are advisory.",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 3 },
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "projectRoot": { "type": "string", "minLength": 1 },
    "head": { "type": ["string", "null"] },
    "gitAvailable": { "type": "boolean" },
    "mode": { "enum": ["baseline", "impact"] },
    "requiredCommands": { "type": "array", "items": { "type": "string" } },
    "requiredChecksSatisfied": { "type": "boolean" },
    "runtimeGeneration": { "$ref": "#/definitions/hash" },
    "checkSpecificationHash": { "$ref": "#/definitions/hash" },
    "verificationHash": { "$ref": "#/definitions/hash" },
    "executionSpecificationHash": { "$ref": "#/definitions/hash" },
    "executionSpecification": { "type": "object", "properties": { "plannedCommands": { "type": "array", "items": { "type": "string" } }, "timeoutMs": { "type": "number", "exclusiveMinimum": 0 }, "mode": { "enum": ["baseline", "impact"] }, "selectedArgs": { "type": "array", "items": { "type": "string" } } }, "required": ["plannedCommands", "timeoutMs", "mode"] },
    "files": {
      "type": "object",
      "additionalProperties": { "oneOf": [ { "type": "string" }, { "type": "object", "properties": { "hash": { "type": "string" }, "provenance": { "enum": ["human", "agent", "unknown"] } }, "required": ["hash"] } ] }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "exitCode": { "type": "integer" },
          "durationMs": { "type": "number" },
          "outputTail": { "type": "string" }
        },
        "required": ["command", "exitCode", "durationMs"]
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["schemaVersion", "verdict", "files", "commands", "createdAt", "projectRoot", "head", "gitAvailable", "mode", "requiredCommands", "requiredChecksSatisfied", "runtimeGeneration", "checkSpecificationHash", "verificationHash", "executionSpecification", "executionSpecificationHash"],
  "definitions": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
