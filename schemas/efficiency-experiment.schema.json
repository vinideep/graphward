{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "efficiency-experiment.schema.json",
  "title": "Frozen descriptive efficiency experiment",
  "description": "A preregistered plan, not evidence that an experiment ran or demonstrated a benefit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "experimentId": {
      "type": "string",
      "minLength": 1
    },
    "frozen": {
      "const": true
    },
    "stage": {
      "enum": [
        "development",
        "directional-pilot",
        "held-out"
      ]
    },
    "preregisteredAt": {
      "type": "string",
      "format": "date-time"
    },
    "collectionStartsAt": {
      "type": "string",
      "format": "date-time"
    },
    "arms": {
      "type": "array",
      "items": {
        "enum": [
          "baseline",
          "current",
          "simplified"
        ]
      },
      "uniqueItems": true,
      "minItems": 3,
      "maxItems": 3
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "armArtifacts": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "current": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "simplified": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "baseline",
        "current",
        "simplified"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "$ref": "#/definitions/conditions"
    },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "sourceRevision": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "modelVersion": {
            "type": "string",
            "minLength": 1
          },
          "requestHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "seed": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "split": {
            "enum": [
              "development",
              "held-out"
            ]
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "command"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "taskId",
          "repository",
          "sourceRevision",
          "model",
          "modelVersion",
          "requestHash",
          "seed",
          "split",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "heldOutPlan": {
      "type": "object",
      "properties": {
        "taskCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "selectionHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeJustification": {
          "type": "string",
          "minLength": 1
        },
        "analysisUnit": {
          "const": "task"
        },
        "blindedReestimation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "method": {
                  "const": "blinded"
                },
                "ruleHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "maximumTasks": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "method",
                "ruleHash",
                "maximumTasks"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "taskCount",
        "repetitions",
        "selectionHash",
        "sizeJustification",
        "analysisUnit",
        "blindedReestimation"
      ],
      "additionalProperties": false
    },
    "decisionPolicy": {
      "type": "object",
      "properties": {
        "tokenReductionTargetPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "acceptancePolicy": {
          "const": "no-decrease"
        },
        "purpose": {
          "const": "descriptive-only"
        }
      },
      "required": [
        "tokenReductionTargetPct",
        "acceptancePolicy",
        "purpose"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "experimentId",
    "frozen",
    "stage",
    "preregisteredAt",
    "collectionStartsAt",
    "arms",
    "repetitions",
    "armArtifacts",
    "conditions",
    "tasks",
    "heldOutPlan",
    "decisionPolicy"
  ],
  "additionalProperties": false,
  "definitions": {
    "conditions": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "hostVersion": {
          "type": "string",
          "minLength": 1
        },
        "toolPolicyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxDurationMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "host",
        "hostVersion",
        "toolPolicyHash",
        "maxTokens",
        "maxDurationMs",
        "temperature"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "directional-pilot"
          }
        }
      },
      "then": {
        "properties": {
          "repetitions": {
            "const": 3
          }
        }
      }
    }
  ]
}
