{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "npx gw hook session-start --host cursor"
      }
    ],
    "preToolUse": [
      {
        "command": "npx gw hook pre-tool-use --host cursor"
      }
    ],
    "afterFileEdit": [
      {
        "command": "npx gw hook post-tool-use --host cursor"
      }
    ],
    "afterShellExecution": [
      {
        "command": "npx gw hook post-tool-use --host cursor"
      }
    ],
    "stop": [
      {
        "command": "npx gw hook stop --host cursor"
      }
    ]
  }
}
