{
  "name": "graphward",
  "version": "1.3.1",
  "description": "Graph-backed codebase intelligence for AI coding editors. Real dependency graphs, MCP server, and installable skills/agents/workflows across 10 AI IDEs.",
  "type": "module",
  "homepage": "https://github.com/vinideep/graphward#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinideep/graphward.git"
  },
  "bugs": {
    "url": "https://github.com/vinideep/graphward/issues"
  },
  "bin": {
    "graphward": "./dist/cli/index.js",
    "gw-mcp": "./dist/mcp/cli.js",
    "gw": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates",
    "bench",
    "schemas",
    "README.md",
    "LICENSE",
    "scripts/build.mjs",
    "scripts/finalize-build.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:integration": "npm run build && node --test --test-concurrency=1 test/install-integration.test.mjs test/mcp.test.mjs test/shiplogic-integration.test.mjs",
    "test:benchmark": "node scripts/benchmark-runner.mjs",
    "test:provider-smoke": "npm run build && node scripts/provider-smoke.mjs",
    "test:graph": "npm run build && node --test test/graph.test.mjs",
    "test:mcp": "npm run build && node --test test/mcp.test.mjs",
    "benchmark:gate1": "npm run build && node --experimental-strip-types benchmarks/phase1-graph-accuracy.ts",
    "benchmark:gate2": "npm run build && node --experimental-strip-types benchmarks/phase2-runtime-mapping.ts",
    "benchmark:gate3": "npm run build && node --experimental-strip-types benchmarks/phase3-retrieval-quality.ts",
    "benchmark:gate4": "npm run build && node --experimental-strip-types benchmarks/phase4-simulation-accuracy.ts",
    "benchmark:gate5": "npm run build && node --experimental-strip-types benchmarks/phase5-scalability.ts",
    "benchmark:gate6": "npm run build && node --experimental-strip-types benchmarks/eval-runner.ts",
    "benchmark:all": "npm run benchmark:gate1 && npm run benchmark:gate2 && npm run benchmark:gate3 && npm run benchmark:gate4 && npm run benchmark:gate5 && npm run benchmark:gate6",
    "prepack": "npm run build",
    "bench": "npm run build && node bench/replay.mjs . --commits 30",
    "prepare": "node scripts/build.mjs --prepare"
  },
  "keywords": [
    "graphward",
    "codebase-intelligence",
    "dependency-graph",
    "mcp",
    "agent-skills",
    "ai-ide",
    "ai-dlc",
    "agentic-workflows",
    "token-optimization",
    "agile",
    "antigravity",
    "cursor",
    "claude-code",
    "copilot",
    "gemini",
    "codex",
    "commandcode",
    "cline",
    "roo-code"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "tree-sitter": ">=0.20.0",
    "tree-sitter-go": ">=0.20.0",
    "tree-sitter-python": ">=0.20.0",
    "tree-sitter-rust": ">=0.20.0",
    "tree-sitter-typescript": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    },
    "tree-sitter-typescript": {
      "optional": true
    },
    "tree-sitter-python": {
      "optional": true
    },
    "tree-sitter-go": {
      "optional": true
    },
    "tree-sitter-rust": {
      "optional": true
    }
  }
}
